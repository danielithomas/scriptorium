# OpenCode configuration
#
# Two groups. The first four are read by *compose* to build the stack; the rest
# are passed into the container by `env_file: .env` and are what OpenCode itself
# reads. Both groups live in this one file.

# --- read by compose ---
WORKSPACE_PATH=./workspace
OLLAMA_NETWORK=ollama_default

# --- passed into the container ---
# The local Ollama endpoint. Reachable on the shared network by container name.
OLLAMA_HOST=http://ollama:11434

# Optional hosted endpoint and its key, used when the local model cannot serve a
# request. Leave both empty to stay entirely local.
OLLAMA_CLOUD_URL=
OLLAMA_API_KEY=

# Which model to prefer locally, and what to fall back to. Without these
# OpenCode has no model to choose and will start but not work.
LOCAL_MODEL=
FALLBACK_MODEL=
