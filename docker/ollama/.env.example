# Ollama configuration
OLLAMA_PORT=11434
OLLAMA_DATA=./data
OLLAMA_API_KEY=

# compose-igpu.yaml only — Intel iGPU / NPU acceleration
# Find these with: getent group render video
VIDEO_GID=44
RENDER_GID=992
GGML_VK_VISIBLE_DEVICES=0

# Host interface to publish on. Default 0.0.0.0 publishes everywhere; set this
# to a specific address to narrow it.
OLLAMA_BIND=0.0.0.0
