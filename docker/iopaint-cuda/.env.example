# IOPaint CUDA — Environment Variables
# Copy to .env and adjust for your host

# ── Model cache location ─────────────────────────────────────────────────────
# Simplest setup: one directory, used exclusively by this stack. The container
# runs as root, so it must be writable by root on the Docker host.
MODEL_DIR=/path/to/iopaint/models

# Optional: point the two caches at directories shared with another stack,
# instead of deriving them from MODEL_DIR. When both are set, MODEL_DIR is
# unused and may be left unset.
#
# slideshow-gen already uses HF_HOME=/models and TORCH_HOME=/models/torch, so
# aiming these at the same shared model root makes both stacks reuse one cache
# rather than downloading the same weights twice:
#
#   HF_CACHE_DIR=/path/to/shared/models            # contains hub/ and xet/
#   TORCH_CACHE_DIR=/path/to/shared/models/torch   # contains hub/checkpoints/
#
# HF_CACHE_DIR is an HF_HOME (the directory *containing* hub/), not the hub
# directory itself.
#HF_CACHE_DIR=
#TORCH_CACHE_DIR=

# ── Server ───────────────────────────────────────────────────────────────────
# Host port for the web UI (container always listens on 8080)
IOPAINT_PORT=8110

# Model loaded at startup: lama, migan, zdiff, or a diffusers repo id
IOPAINT_MODEL=lama

# Inference device: cuda or cpu
IOPAINT_DEVICE=cuda

# ── Batch workspace (optional) ───────────────────────────────────────────────
# Drop images into IMAGES_PATH and work through them in the UI's file browser,
# saving results to OUTPUT_PATH. Requires the --input/--output-dir flags below.
# The listing is a live filesystem glob, so files added while the server is
# running show up without a restart.
#
# Only .jpg/.jpeg/.png are listed, top level only — subfolders are ignored.
# IOPaint creates a thumbnails/ directory inside OUTPUT_PATH.
IMAGES_PATH=./images
OUTPUT_PATH=./output

# IOPaint hardcodes its thumbnail cache to <output-dir>/thumbnails. Set this to
# put the thumbnails somewhere else — an empty thumbnails/ mountpoint still
# appears in OUTPUT_PATH, but the files land here.
#THUMBNAILS_PATH=./thumbnails

# Additional flags appended to `iopaint start`
# To enable the batch workspace above:
#   IOPAINT_EXTRA_ARGS=--input=/images --output-dir=/output
IOPAINT_EXTRA_ARGS=
